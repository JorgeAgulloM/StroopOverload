rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow write: if false;

      // Server-only data (e.g. Patata Caliente's hidden bomb deadline) that must
      // never reach any client, including players who can legitimately read the
      // room doc itself. Firestore rules can't redact a single field from an
      // otherwise-readable document, so anything that must stay secret from
      // players lives here instead of as a field on the room doc. Only the
      // Admin SDK (Cloud Functions) can touch this subcollection.
      match /private/{document=**} {
        allow read, write: if false;
      }
    }

    // Per-uid call counters written only by Cloud Functions (see rateLimit.ts).
    // A client that could read or write these could sidestep its own limits.
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // Profile + leaderboard. Read is open to any authenticated user (the leaderboard query
    // needs to read every user's doc, not just the caller's own).
    //
    // Writes are the caller's own doc AND may not touch the scoring fields: those are
    // written only by Cloud Functions (submitSoloRun / onRoomFinished, see
    // userProfile.ts) with the Admin SDK, which bypasses these rules. Before this, any
    // client could set its own `points` and top the leaderboard without playing --
    // a plain REST call with a valid ID token was enough. isAdFree/isPremium are locked
    // for the same reason: they are entitlements, not preferences.
    match /users/{uid} {
      function serverOwnedFields() {
        return [
          'points', 'highScore', 'experience', 'level',
          'matchesPlayed', 'matchesWon', 'matchesLost', 'abandonedMatches',
          'dailyStreak', 'lastPlayedAtEpochMs', 'awardedAchievements',
          'isAdFree', 'isPremium'
        ];
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(serverOwnedFields());
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedFields());
      // Account deletion wipes the caller's own document.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

  }
}
